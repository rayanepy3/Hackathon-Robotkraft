# Source unique de configuration, lue par le Makefile.
# Syntaxe Makefile : CLE=valeur, sans guillemets, sans espace autour du "=".
# Surcharges perso non versionnées : config/robotkraft.env.local (même syntaxe).
# Surcharge ponctuelle : make record NUM_EPISODES=10

# --- Bras SO-101 : symlinks stables créés par `make udev` ---
FOLLOWER_PORT=/dev/so101_follower
LEADER_PORT=/dev/so101_leader
# Les ids donnent leur nom aux fichiers de calibration : ne plus les changer après calibration.
# Mêmes ids que le repo du challenge, pour réutiliser ses calibrations (make import-calib).
FOLLOWER_ID=follower_arm
LEADER_ID=leader_arm

# --- Caméras : 640x480 @ 30 fps pour les deux, profondeur désactivée ---
CAM_WIDTH=640
CAM_HEIGHT=480
CAM_FPS=30
# Fréquence d'enregistrement et de pilotage (dataset, rollout) : les caméras tournent à CAM_FPS,
# l'enregistrement garde la dernière image à chaque pas. Un dataset ne mélange pas deux fréquences,
# et un modèle se pilote à la fréquence de son dataset (tri_v1 et quick : 30).
REC_FPS=15
# camera1 = vue fixe : flux RGB de l'OAK-D Lite, publié en ZMQ par scripts/oak_zmq_server.py
CAM1_ZMQ_PORT=5555
CAM1_ZMQ_NAME=top
# camera2 = poignet : chemin stable /dev/v4l/by-id/...-video-index0 (voir `make cameras`)
WRIST_CAM=/dev/v4l/by-id/usb-Innomaker_Innomaker-U20CAM-1080p-S1_SN0001-video-index0
# Caméras que make cameras ne doit pas allumer (morceaux de nom, séparés par des virgules) : webcam du PC.
CAM_IGNORE=User Facing

# --- Tâche et dataset : une seule tâche, une seule phrase, identique au record et au rollout ---
HF_USER=CHANGE_ME
TASK_NAME=pickplace
TASK_TEXT=Pick up the cube and place it in the box.
DATASET_REPO_ID=$(HF_USER)/robotkraft_$(TASK_NAME)
NUM_EPISODES=50
EPISODE_TIME_S=20
RESET_TIME_S=10
PUSH_TO_HUB=false
# Épreuve TRI (make record-tri, make tri) : une phrase par couleur, identique au record et au rollout.
TRI_TEXT_B=Put a blue tube in the leftmost empty slot.
TRI_TEXT_J=Put a yellow tube in the leftmost empty slot.
TRI_TEXT_R=Put a red tube in the leftmost empty slot.
HUB_PRIVATE=true

# --- Entraînement SmolVLA ---
POLICY_BASE=lerobot/smolvla_base
TRAIN_STEPS=20000
BATCH_SIZE=32
SAVE_FREQ=5000
TRAIN_OUTPUT_DIR=outputs/train/smolvla_$(TASK_NAME)
PUSH_MODEL=false
MODEL_REPO_ID=$(HF_USER)/smolvla_robotkraft_$(TASK_NAME)
# ACT, policy de secours sur le même dataset : inférence fluide sur le CPU du PC
# (mesuré : 0,3 s par paquet de 100 actions, contre 5 s par paquet de 50 pour SmolVLA).
ACT_STEPS=100000
ACT_BATCH_SIZE=8
ACT_SAVE_FREQ=10000
ACT_OUTPUT_DIR=outputs/train/act_$(TASK_NAME)
ACT_MODEL_REPO_ID=$(HF_USER)/act_robotkraft_$(TASK_NAME)
# HF Jobs (payant, facturé à la seconde) : uniquement avec make train-hf-job CONFIRM_PAID=yes
HF_JOB_FLAVOR=a10g-small
HF_JOB_TIMEOUT=8h

# --- Rollout et évaluation ---
# Modèle piloté au rollout : dépôt du Hub (entraînement sur le serveur GPU) ou dossier local,
# ex. outputs/train/smolvla_pickplace/checkpoints/last/pretrained_model. ACT : $(ACT_MODEL_REPO_ID).
POLICY_PATH=$(MODEL_REPO_ID)
POLICY_DEVICE=cpu
EVAL_EPISODES=10
# Sur CPU avec SmolVLA, le bras avance par à-coups : prévoir EVAL_EPISODE_TIME_S=90.
EVAL_EPISODE_TIME_S=30
EVAL_RESET_TIME_S=15
# Inférence asynchrone (policy sur une machine GPU du réseau) : make rollout-async
ASYNC_SERVER=
ASYNC_POLICY=$(MODEL_REPO_ID)

# --- Épreuves : make tri, make etiquette (code dans TRI/, ETIQ/, MASSE/ ; outils communs dans COMMUN/) ---
# Un essai du modèle dure EPREUVE_SECONDS (25 s avec ASYNC_SERVER, 90 s sur le CPU du PC) ; une action
# ratée est recommencée jusqu'à MAX_TRIES fois. Images et journal : outputs/epreuves/<épreuve>_<heure>/.
MAX_TRIES=4
# TRI : tubes de couleur, rangés groupe par groupe dans la place libre la plus à gauche.
TRI_TASK_NAME=tri_v2
TRI_ORDER=BJR
TRI_POLICY=dbal67/Robotkraft_TRI_v2
# Fréquence du dataset du modèle TRI (tri_v1 : 30, tri_v2 : 15)
TRI_POLICY_FPS=30
# ETIQ : saisir l'objet dont l'étiquette porte le mot donné. {k} = numéro de place (rack) ou de zone (table).
ETIQ_TASK_NAME=etiq_v1
ETIQ_POLICY=dbal67/Robotkraft_ETIQ_saisir_v1
ETIQ_POLICY_FPS=15
ETIQ_TEXT_SLOT=Pick up the tube in slot {k}.
ETIQ_TEXT_ZONE=Pick up the object in zone {k}.
# ETIQ : lecture du plus simple au plus dur. 1) OAK à distance ; 2) REGARDER : le bras se lève, la caméra
# poignet lit le rack de haut ; 3) SAISIR la place k, MONTRER le tube à l'OAK en le tournant, REPOSER s'il n'est pas le bon.
# 3 datasets / 3 modèles (3 GPU) : saisir, lire (regarder + montrer, 2 phrases), reposer.
ETIQ_TEXT_LOOK=Look at the rack from above.
ETIQ_TEXT_SHOW=Show the tube to the camera.
ETIQ_TEXT_PLACE=Put the tube back in slot {k}.
ETIQ_POLICY_SHOW=dbal67/Robotkraft_ETIQ_lire_v1
ETIQ_POLICY_PLACE=dbal67/Robotkraft_ETIQ_reposer_v1
# Durée max d'un épisode de sous-geste (flèche → pour finir plus tôt)
SKILL_TIME_S=15
# Caméra qui lit les étiquettes : oak ou poignet
LECTURE_CAM=oak


# docker : image du challenge + couche smolvla (make install). native : lerobot installé dans l'env actif.
RUNNER=docker
BASE_IMAGE=ghcr.io/alsacedigitale/robotkraft:latest
IMAGE=robotkraft-smolvla:local
# Cache Hugging Face monté dans le conteneur : calibrations, datasets, modèles, token.
CACHE_DIR=.cache